{
  "productName": "dawsu! Tauri",
  "version": "1.3.0-alpha.1",
  "identifier": "dev.dawsu.editor.tauri",
  "build": { "beforeBuildCommand": "npm --prefix ui run build", "frontendDist": "dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "dawsu!", "width": 1440, "height": 900, "minWidth": 1024, "minHeight": 700 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico", "icons/icon.png"] }
}
